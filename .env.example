# ==============================================================================
# FabSimple - Demo Request Notification & Brevo SMTP Configuration
# ==============================================================================

# Destination Email: Where demo requests will be delivered.
# To change who receives the notification, simply update this email address:
DEMO_NOTIFICATION_EMAIL=gourav.naik@gmail.com

# Brevo SMTP Configuration
# Get your SMTP key from Brevo: https://app.brevo.com/settings/keys/smtp
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_smtp_login
SMTP_PASS=your_brevo_smtp_master_key_or_password

# Sender address (must match a verified sender email in your Brevo account)
SMTP_FROM="FabSimple Walkthroughs" <notifications@fabsimple.io>
